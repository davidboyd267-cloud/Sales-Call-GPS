<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#0B0B0A" />
  <title>Coach Dave | Live Call GPS</title>
  <style>
    :root {
      --bg: #0B0B0A;
      --surface: #141413;
      --surface-2: #1C1C1B;
      --surface-3: #242422;
      --border: #2A2A28;
      --border-soft: #1F1F1D;
      --text: #F4F1EA;
      --text-2: #B5B0A6;
      --text-3: #7A766E;
      --amber: #E9933A;
      --amber-soft: rgba(233, 147, 58, 0.12);
      --green: #6BBF83;
      --green-soft: rgba(107, 191, 131, 0.12);
      --red: #E5645A;
      --red-soft: rgba(229, 100, 90, 0.12);
      --blue: #7FA5E8;
      --blue-soft: rgba(127, 165, 232, 0.12);
      --purple: #B38CE8;
      --purple-soft: rgba(179, 140, 232, 0.12);
      --mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      --serif: Georgia, "Times New Roman", serif;
      --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--sans);
      font-size: 15px;
      line-height: 1.5;
      min-height: 100vh;
      min-height: 100dvh;
      -webkit-font-smoothing: antialiased;
      -webkit-tap-highlight-color: transparent;
      background-image:
        radial-gradient(ellipse 80% 50% at 50% -10%, rgba(233,147,58,0.08), transparent),
        radial-gradient(ellipse 60% 40% at 100% 100%, rgba(107,191,131,0.04), transparent);
    }

    .app {
      display: grid;
      grid-template-columns: 280px 1fr;
      grid-template-rows: 60px 1fr;
      grid-template-areas:
        "header header"
        "nav main";
      min-height: 100vh;
      min-height: 100dvh;
    }

    @media (max-width: 860px) {
      .app {
        grid-template-columns: 1fr;
        grid-template-rows: 52px auto 1fr;
        grid-template-areas:
          "header"
          "nav"
          "main";
      }
    }

    header {
      grid-area: header;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 16px;
      border-bottom: 1px solid var(--border-soft);
      background: rgba(11, 11, 10, 0.88);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      position: sticky;
      top: 0;
      z-index: 20;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
    }

    .brand-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--amber);
      box-shadow: 0 0 12px var(--amber);
      flex-shrink: 0;
    }

    .brand-title {
      font-family: var(--serif);
      font-size: 17px;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .brand-sub {
      font-family: var(--mono);
      font-size: 10px;
      color: var(--text-3);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      padding: 3px 7px;
      border: 1px solid var(--border);
      border-radius: 4px;
      white-space: nowrap;
    }

    @media (max-width: 520px) {
      .brand-sub { display: none; }
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }

    .timer {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: var(--mono);
      font-size: 13px;
      color: var(--text-2);
    }

    .timer-display {
      min-width: 52px;
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    .timer-display.warn { color: var(--amber); }
    .timer-display.over { color: var(--red); }

    .btn, .next-btn, .fab, .tab, .scale-num {
      appearance: none;
      -webkit-appearance: none;
    }

    .btn {
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 7px 12px;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: var(--surface-2);
      color: var(--text);
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .btn:hover { background: var(--surface-3); }
    .btn.danger {
      color: var(--red);
      border-color: rgba(229,100,90,0.35);
    }

    nav {
      grid-area: nav;
      border-right: 1px solid var(--border-soft);
      padding: 16px 12px;
      overflow-y: auto;
      background: rgba(20,20,19,0.4);
    }

    @media (max-width: 860px) {
      nav {
        border-right: none;
        border-bottom: 1px solid var(--border-soft);
        padding: 10px 12px;
        overflow-x: auto;
        overflow-y: hidden;
        display: flex;
        flex-wrap: nowrap;
        gap: 6px;
        -webkit-overflow-scrolling: touch;
      }
      nav::-webkit-scrollbar { display: none; }
      .nav-label { display: none; }
    }

    .nav-label {
      font-family: var(--mono);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--text-3);
      padding: 4px 10px;
      margin: 10px 0 6px;
    }

    .nav-label:first-child { margin-top: 0; }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 10px;
      border-radius: 6px;
      cursor: pointer;
      transition: background 0.12s ease, color 0.12s ease;
      color: var(--text-2);
      white-space: nowrap;
      user-select: none;
    }

    .nav-item:hover {
      background: var(--surface-2);
      color: var(--text);
    }

    .nav-item.active {
      background: var(--amber-soft);
      color: var(--amber);
    }

    .nav-item.active .nav-num {
      color: var(--amber);
      border-color: var(--amber);
    }

    .nav-item.exit { color: var(--text-3); }

    .nav-item.exit.active {
      background: var(--red-soft);
      color: var(--red);
    }

